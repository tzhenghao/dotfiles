# Reformat single and double quotes to ' and ".
reformat_quotes() {
  local file tempFile
  for file in "$@"
  do
    tempFile=$(mktemp) || return 1
    if ! { sed -e 's/“/"/g' -e 's/”/"/g' -e "s/’/'/g" -e "s/‘/'/g" "$file" > "$tempFile" &&
      cat "$tempFile" > "$file"; }; then
      rm -f "$tempFile"
      return 1
    fi
    rm -f "$tempFile"
  done
}

# For note taking.
notes() {
  if [[ "$#" -eq 0 ]]; then
    less "$HOME/Dropbox/notes.txt"
  else
    echo "$@" >> "$HOME/Dropbox/notes.txt"
  fi
}

# Help with extractions
extract() {
  if [ ! -f "$1" ] ; then
    echo "'$1' is not a valid file!" >&2
    return 1
  fi
  case "$1" in
    *.tar.bz2)   tar xvjf "$1"    ;;
    *.tar.gz)    tar xvzf "$1"    ;;
    *.bz2)       bunzip2 "$1"     ;;
    *.rar)       unrar x "$1"     ;;
    *.gz)        gunzip "$1"      ;;
    *.tar)       tar xvf "$1"     ;;
    *.tbz2)      tar xvjf "$1"    ;;
    *.tgz)       tar xvzf "$1"    ;;
    *.zip)       unzip "$1"       ;;
    *.Z)         uncompress "$1"  ;;
    *.7z)        7z x "$1"        ;;
    *)           echo "don't know how to extract '$1'..." >&2; return 1 ;;
  esac
}

